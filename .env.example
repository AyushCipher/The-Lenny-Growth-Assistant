# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# Safe defaults for local development and Docker Compose
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL primary)
# For Docker Compose: postgresql+asyncpg://postgres:postgres@postgres:5432/lenny_growth
# For Local Host: postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
# Auto-fallback to SQLite if Postgres is unavailable: sqlite+aiosqlite:///./lenny_growth.db
DATABASE_URL=sqlite+aiosqlite:///./lenny_growth.db

# Model Provider Configuration (ollama | anthropic | openai)
DEFAULT_PROVIDER=ollama

# Local LLM - Ollama Configuration (Mandatory for Demo)
# Inside Docker: http://ollama:11434
# On Host Machine: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=60.0

# Cloud LLM - Anthropic Claude SDK Configuration (Optional)
# ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cloud LLM - OpenAI API Configuration (Optional)
# OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# Cloud LLM - Groq Cloud Configuration (Optional - Ultra Fast)
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Hybrid RAG Settings
RAG_TOP_K=5
RRF_K=60
